rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Active Delivery Offices Collection
    match /offices/{officeId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Pending External Registration Submissions
    match /pending_offices/{pendingId} {
      allow create: if true; // Anyone can submit an office registration request via register.html
      allow read, update, delete: if request.auth != null; // Only admins can review and approve
    }

    // Driver Problem Reports & Feedback
    match /reports/{reportId} {
      allow create: if true; // Drivers can submit problem reports from index.html
      allow read, update, delete: if request.auth != null; // Only admins can view and resolve
    }

    // Audit Trail Log
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
    }
  }
}
