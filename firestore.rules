rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Active Delivery Offices Collection
    match /offices/{officeId} {
      allow read, write: if true;
    }

    // Pending External Registration Submissions
    match /pending_offices/{pendingId} {
      allow read, write: if true;
    }

    // Driver Problem Reports & Feedback
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Driver Visit Analytics Statistics
    match /page_visits/{visitId} {
      allow read, create: if true;
    }

    // System Errors & Failed Attempts Log
    match /system_errors/{errorId} {
      allow read, create: if true;
    }

    // Audit Trail Log & Whitelisted Admins
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /whitelisted_admins/{adminId} {
      allow read, write: if true;
    }
  }
}
